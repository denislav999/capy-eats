# Maven and Java build outputs
target/
build/
out/
*.class
*.jar
*.war
*.ear
# The wrapper JAR is a build tool, not a generated application artifact.
!**/.mvn/wrapper/maven-wrapper.jar
# Keep pom.xml, mvnw, mvnw.cmd and .mvn/ configuration trackable.

# IntelliJ IDEA
.idea/
*.run.xml
*.iws
*.iml
*.ipr

# Logs and JVM diagnostics
*.log
*.log.*
logs/
hs_err_pid*
replay_pid*
*.hprof

# Temporary files and editor backups
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
/tmp/
/temp/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local environment secrets; only sanitized templates belong in Git.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.secrets/
secrets/

# Local Spring profiles (must be explicitly activated or imported).
# Keep application.properties/yml/yaml and shared dev/test/prod profiles tracked.
application-local.properties
application-local.yml
application-local.yaml
application-local-*.properties
application-local-*.yml
application-local-*.yaml

# Private keys and credential stores; public certificates remain trackable.
*.key
*.p12
*.pfx
*.jks
*.keystore
